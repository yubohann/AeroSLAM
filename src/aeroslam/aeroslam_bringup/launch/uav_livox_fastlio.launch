<?xml version="1.0"?>

<!--
  AeroSLAM scenario: hector_quadrotor + simulated Livox Mid-360 + FAST-LIO.

  Requires the frontier modules: run scripts/setup.sh in frontier mode.

  Example:
    roslaunch aeroslam_bringup uav_livox_fastlio.launch
    roslaunch aeroslam_bringup uav_livox_fastlio.launch gui:=false headless:=true rviz:=false
-->
<launch>
  <arg name="world" default="$(find hector_gazebo_worlds)/worlds/rolling_landscape_120m.world" />
  <arg name="gui" default="true" />
  <arg name="headless" default="false" />
  <arg name="rviz" default="true" />
  <arg name="use_pose_estimation" default="false" />
  <arg name="livox_scan_period" default="0.0" />

  <!-- Gazebo world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" />
    <arg name="paused" value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="debug" value="false" />
  </include>

  <!-- Quadrotor with Livox sensor -->
  <include file="$(find hector_quadrotor_gazebo)/launch/spawn_quadrotor.launch">
    <arg name="model" value="$(find aeroslam_bringup)/urdf/quadrotor_with_livox.gazebo.xacro" />
    <arg name="z" value="0.3" />
    <arg name="use_pose_estimation" value="$(arg use_pose_estimation)" />
  </include>

  <!-- hector IMU -> FAST-LIO IMU input -->
  <node pkg="topic_tools" type="relay" name="imu_relay" args="raw_imu /livox/imu" output="screen" />

  <!-- Simulated Livox PointCloud -> Livox CustomMsg (FAST-LIO input format) -->
  <node pkg="aeroslam_livox_bridge" type="livox_sim_bridge" name="livox_sim_bridge" output="screen">
    <param name="input_topic" value="/livox/lidar_sim" />
    <param name="output_topic" value="/livox/lidar" />
    <param name="frame_id" value="livox_frame" />
    <param name="scan_period" value="$(arg livox_scan_period)" />
  </node>

  <!-- FAST-LIO -->
  <rosparam command="load" file="$(find aeroslam_bringup)/config/fastlio_livox_sim.yaml" />
  <param name="feature_extract_enable" type="bool" value="0" />
  <param name="point_filter_num" type="int" value="3" />
  <param name="max_iteration" type="int" value="3" />
  <param name="filter_size_surf" type="double" value="0.5" />
  <param name="filter_size_map" type="double" value="0.5" />
  <param name="cube_side_length" type="double" value="1000" />
  <param name="runtime_pos_log_enable" type="bool" value="0" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
</launch>

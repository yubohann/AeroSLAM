<?xml version="1.0"?>

<!--
  AeroSLAM scenario: hector_quadrotor + simulated Livox sensor only
  (no SLAM backend). Useful for checking the sensing chain and RViz.

  Requires the frontier modules: run scripts/setup.sh in frontier mode.
-->
<launch>
  <arg name="world" default="$(find hector_gazebo_worlds)/worlds/rolling_landscape_120m.world" />
  <arg name="gui" default="true" />
  <arg name="headless" default="false" />
  <arg name="rviz" default="true" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" />
    <arg name="paused" value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="debug" value="false" />
  </include>

  <include file="$(find hector_quadrotor_gazebo)/launch/spawn_quadrotor.launch">
    <arg name="model" value="$(find aeroslam_bringup)/urdf/quadrotor_with_livox.gazebo.xacro" />
    <arg name="z" value="0.3" />
  </include>

  <node pkg="topic_tools" type="relay" name="imu_relay" args="raw_imu /livox/imu" output="screen" />

  <node pkg="aeroslam_livox_bridge" type="livox_sim_bridge" name="livox_sim_bridge" output="screen">
    <param name="input_topic" value="/livox/lidar_sim" />
    <param name="output_topic" value="/livox/lidar" />
    <param name="frame_id" value="livox_frame" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find livox_laser_simulation)/rviz/livox_simulation.rviz" />
</launch>

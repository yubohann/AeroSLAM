# Normalize all text files to LF in the repository
* text=auto

# Shell & build scripts
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
Dockerfile text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# ROS / config
*.launch text eol=lf
*.xml    text eol=lf
*.xacro  text eol=lf
*.urdf   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.msg    text eol=lf
*.srv    text eol=lf
*.action text eol=lf

# Docs
*.md  text eol=lf
*.rst text eol=lf
*.dox text eol=lf

# C/C++
*.c   text eol=lf
*.cc  text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.hh  text eol=lf
*.hpp text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.avi  binary
*.7z   binary
*.zip  binary
*.tar  binary
*.gz   binary
*.dae  binary
*.stl  binary
*.obj  binary
*.mtl  binary
*.pgm  binary
*.png.xz binary
*.db   binary
